{
  "name": "@brianbuie/kit",
  "version": "3.7.1",
  "license": "Unlicense",
  "description": "Basic tools for quick projects",
  "author": "Brian Buie <brian@buie.dev>",
  "scripts": {
    "build": "prettier ./src -w && tsdown",
    "test:src": "tsc && vitest run",
    "test:pack": "pnpm pack --out .temp/kit.tgz && attw .temp/kit.tgz --profile esm-only",
    "test": "pnpm test:src && pnpm build && pnpm test:pack",
    "preversion": "pnpm test",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.9.1",
    "@types/probe-image-size": "^7.2.5",
    "chalk": "^6.0.0",
    "date-fns": "^4.1.0",
    "extract-domain": "^5.0.2",
    "fast-csv": "^5.0.5",
    "format-duration": "^3.0.2",
    "lodash-es": "^4.17.23",
    "loupe": "^3.2.1",
    "mime-types": "^3.0.2",
    "probe-image-size": "^7.3.0",
    "sanitize-filename": "^1.6.3",
    "string-argv": "^0.3.2",
    "trash": "^10.1.1"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "prettier": "^3.7.4",
    "quicktype-core": "^23.2.6",
    "tsdown": "^0.16.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "quicktype-core": "*"
  },
  "peerDependenciesMeta": {
    "quicktype-core": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/node.d.mts",
      "node": "./dist/node.mjs",
      "default": "./dist/core.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./cache": {
      "types": "./dist/cache.d.mts",
      "default": "./dist/cache.mjs"
    },
    "./cmd": {
      "types": "./dist/cmd.d.mts",
      "default": "./dist/cmd.mjs"
    },
    "./core/cache": {
      "types": "./dist/core/cache.d.ts",
      "default": "./dist/core/cache.js"
    },
    "./dir": {
      "types": "./dist/dir.d.mts",
      "default": "./dist/dir.mjs"
    },
    "./env": {
      "types": "./dist/env.d.ts",
      "default": "./dist/env.js"
    },
    "./fetcher": {
      "types": "./dist/fetcher.d.ts",
      "default": "./dist/fetcher.js"
    },
    "./file": {
      "types": "./dist/file.d.mts",
      "default": "./dist/file.mjs"
    },
    "./format": {
      "types": "./dist/format.d.ts",
      "default": "./dist/format.js"
    },
    "./log": {
      "types": "./dist/log.d.ts",
      "default": "./dist/log.js"
    },
    "./path": {
      "types": "./dist/path.d.mts",
      "default": "./dist/path.mjs"
    },
    "./snapshot": {
      "types": "./dist/snapshot.d.ts",
      "default": "./dist/snapshot.js"
    },
    "./store": {
      "types": "./dist/store.d.ts",
      "default": "./dist/store.js"
    },
    "./timeout": {
      "types": "./dist/timeout.d.ts",
      "default": "./dist/timeout.js"
    },
    "./type-writer": {
      "types": "./dist/type-writer.d.mts",
      "default": "./dist/type-writer.mjs"
    }
  },
  "files": [
    "src",
    "dist",
    "tsconfig.json",
    "prettier.config.js"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brianbuie/kit.git"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "type": "module",
  "sideEffects": false
}
